{"nodes": [{"id": "how_to_make_omnigate_web_apps_spec", "label": "How to make OmniGate web apps (spec)", "file_type": "document", "source_file": "HOW_TO_MAKE_OMNIGATE_WEB_APPS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_to_make_omnigate_web_apps_omnigate_gateway", "label": "OmniGate Gateway", "file_type": "concept", "source_file": "HOW_TO_MAKE_OMNIGATE_WEB_APPS.md", "source_location": "The runtime model (read before coding)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates static files behind a per-app login, brokers a same-origin user-level file API via HttpOnly cookie (no token, no CORS), and forces every app session to User role."}, {"id": "how_to_make_omnigate_web_apps_priv_data", "label": "/priv_data/ Persistent App Storage", "file_type": "concept", "source_file": "HOW_TO_MAKE_OMNIGATE_WEB_APPS.md", "source_location": "Persistent app storage: /priv_data/", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One writable store per installed app shared by all users, stored outside code and Git so code updates/rollbacks leave data untouched; not a security boundary between sibling apps."}, {"id": "how_to_make_omnigate_web_apps_static_bundle", "label": "Static App Bundle (ZIP)", "file_type": "concept", "source_file": "HOW_TO_MAKE_OMNIGATE_WEB_APPS.md", "source_location": "What an app is", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apps are static HTML/CSS/JS only; the gateway serves files verbatim with relative same-origin URLs, no CDN, no backend."}, {"id": "how_to_make_omnigate_web_apps_bundle_checks", "label": "Static Bundle Checks", "file_type": "rationale", "source_file": "HOW_TO_MAKE_OMNIGATE_WEB_APPS.md", "source_location": "Static bundle checks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reject n